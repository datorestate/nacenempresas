{
  "actorSpecification": 1,
  "name": "spain-new-companies-borme",
  "title": "Spain New Companies & Corporate Events (BORME) — GDPR-safe",
  "description": "Daily new Spanish companies (incorporations) and corporate events from the official BORME, cleaned and classified by sector. Company data only: no personal data of directors or shareholders.",
  "version": "1.0",
  "buildTag": "latest",
  "input": "./input_schema.json",
  "dockerfile": "../Dockerfile",
  "dockerContextDir": "../..",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "overview": {
          "title": "Companies",
          "transformation": {
            "fields": [
              "fecha_publicacion",
              "provincia",
              "denominacion",
              "forma_juridica",
              "tipo",
              "municipio",
              "sector",
              "capital",
              "objeto_social",
              "borme_id"
            ]
          },
          "display": {
            "component": "table"
          }
        }
      }
    }
  },
  "output": "./output_schema.json"
}
